---
import type { CollectionEntry } from 'astro:content';
import Shot from './Shot.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const p = project.data;
// Every card drifts by the same small amount. The picture itself is never cropped.
const drift = 0.015;
---

<li class="item" data-work-item data-parallax style={`--drift:${drift};--start:${p.place.start};--span:${p.place.span};--brand-on-grey:${p.brand.onGrey};--brand-on-black:${p.brand.onBlack}`}>
  <a class="link brand-trigger" href={`/projects/${project.id}/`}>
    <Shot
      src={p.cover}
      alt={p.coverAlt}
      sizes={`(max-width: 900px) 100vw, ${Math.round((p.place.span / 12) * 100)}vw`}
      eager={p.order === 1}
      morph={`cover-${project.id}`}
    />
    <div class="meta">
      <h3 class="title brand-name t-title">{p.title}</h3>
      <p class="kind t-small muted">{p.kind}</p>
      <p class="years t-small muted tnum">{p.years}{p.current && <span class="now"> <i aria-hidden="true"></i>Current</span>}</p>
      <p class="card t-small muted">{p.card}</p>
    </div>
  </a>
</li>

<style>
  .item {
    grid-column: var(--start) / span var(--span);
  }
  .link { display: block; }
  .meta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-1) var(--layout-gutter);
    padding-top: var(--space-5);
  }
  .title { grid-column: 1 / -1; padding-bottom: var(--space-1); }
  .years { text-align: right; }
  .now i {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin: 0 0.35em 0 0.75em;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.08em;
  }
  .card { grid-column: 1 / -1; max-width: 46ch; padding-top: var(--space-3); }

  @media (max-width: 900px) {
    .item { grid-column: 1 / -1; }
  }
</style>
