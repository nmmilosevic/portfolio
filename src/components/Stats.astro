---
import { stats } from '../data/site';
---

<dl class="stats grid">
  {
    stats.map((s) => (
      <div class="stat">
        <dd class="value t-display-m tnum" data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</dd>
        <dt class="label t-small muted">{s.label}</dt>
      </div>
    ))
  }
</dl>

<style>
  .stats { margin-top: var(--space-section); row-gap: var(--space-6); }
  .stat {
    grid-column: span 3;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  @media (max-width: 900px) { .stat { grid-column: span 3; } }
  @media (max-width: 560px) { .stat { grid-column: span 2; } }
</style>
