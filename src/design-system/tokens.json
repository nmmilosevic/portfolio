{
  "$description": "Single source of truth for the site. Format follows the W3C Design Tokens spec, so it can be imported in Figma (Tokens Studio or similar). Edit a value, then run: npm run tokens",

  "color": {
    "gray": {
      "$type": "color",
      "0": { "$value": "#ffffff" },
      "100": { "$value": "#ececec" },
      "200": { "$value": "#d9d9d9" },
      "300": { "$value": "#bfbfbf" },
      "400": { "$value": "#a0a0a0" },
      "500": { "$value": "#7a7a7a" },
      "600": { "$value": "#4d4d4d" },
      "700": { "$value": "#333333" },
      "800": { "$value": "#1f1f1f" },
      "1000": { "$value": "#000000" }
    },
    "accent": {
      "hue": { "$type": "number", "$value": 268, "$description": "Change this one number to recolour the whole site. Try it live on /system." },
      "base": { "$type": "color", "$value": "oklch(0.47 0.29 var(--color-accent-hue))", "$description": "The one accent blue, the same on grey and on black." }
    }
  },

  "theme": {
    "$description": "Semantic colours. Components only use these, never the raw grays. They are registered with @property so they can animate when a section flips to black.",
    "light": {
      "$type": "color",
      "bg": { "$value": "{color.gray.200}", "$description": "Page background" },
      "bg-raised": { "$value": "{color.gray.100}", "$description": "Slightly lifted surface" },
      "fg": { "$value": "{color.gray.1000}", "$description": "Main text" },
      "fg-muted": { "$value": "{color.gray.600}", "$description": "Secondary text, passes AA on bg" },
      "fill": { "$value": "{color.gray.1000}", "$description": "Button fill. Swaps at once in the middle of a page fade" },
      "on-fill": { "$value": "{color.gray.200}", "$description": "Text on fill. Swaps with it, so a label never fades out" },
      "line": { "$value": "rgb(0 0 0 / 0.18)", "$description": "Dividers" },
      "grid-line": { "$value": "rgb(0 0 0 / 0.07)", "$description": "Resting grid" },
      "grid-glow": { "$value": "rgb(0 0 0 / 0.42)", "$description": "Grid under the pointer" },
      "accent": { "$value": "{color.accent.base}", "$description": "Hover and live states, same on both surfaces" },
      "accent-pressed": { "$value": "color-mix(in oklab, var(--color-accent-base) 78%, #000)", "$description": "Button while pressed" },
      "focus": { "$value": "{color.accent.base}", "$description": "Keyboard focus ring" },
      "on-accent": { "$value": "{color.gray.0}", "$description": "Text on accent" }
    },
    "dark": {
      "$type": "color",
      "bg": { "$value": "{color.gray.1000}" },
      "bg-raised": { "$value": "{color.gray.800}" },
      "fg": { "$value": "{color.gray.100}" },
      "fg-muted": { "$value": "{color.gray.400}" },
      "fill": { "$value": "{color.gray.100}" },
      "on-fill": { "$value": "{color.gray.1000}" },
      "line": { "$value": "rgb(255 255 255 / 0.2)" },
      "grid-line": { "$value": "rgb(255 255 255 / 0.08)" },
      "grid-glow": { "$value": "rgb(255 255 255 / 0.45)" },
      "accent": { "$value": "{color.accent.base}" },
      "accent-pressed": { "$value": "color-mix(in oklab, var(--color-accent-base) 78%, #000)" },
      "focus": { "$value": "{color.gray.100}" },
      "on-accent": { "$value": "{color.gray.0}" }
    }
  },

  "font": {
    "$type": "fontFamily",
    "sans": { "$value": "'Hubot Sans Variable', ui-sans-serif, system-ui, sans-serif" }
  },

  "type": {
    "$description": "Each role gives four variables, for example --type-body-size. Display sizes are fluid: they follow the viewport between the two values in the clamp.",
    "micro": { "$type": "typography", "$value": { "fontSize": "0.8125rem", "lineHeight": "1.3", "letterSpacing": "0", "fontWeight": "450" } },
    "small": { "$type": "typography", "$value": { "fontSize": "0.9375rem", "lineHeight": "1.4", "letterSpacing": "0", "fontWeight": "450" } },
    "body": { "$type": "typography", "$value": { "fontSize": "clamp(1.0625rem, 0.99rem + 0.3vw, 1.25rem)", "lineHeight": "1.45", "letterSpacing": "0", "fontWeight": "400" } },
    "lead": { "$type": "typography", "$value": { "fontSize": "clamp(1.375rem, 1.12rem + 1.1vw, 2.125rem)", "lineHeight": "1.22", "letterSpacing": "-0.012em", "fontWeight": "450" } },
    "title": { "$type": "typography", "$value": { "fontSize": "clamp(1.625rem, 1.26rem + 1.55vw, 2.75rem)", "lineHeight": "1.08", "letterSpacing": "-0.02em", "fontWeight": "500" } },
    "display-s": { "$type": "typography", "$value": { "fontSize": "clamp(2.25rem, 1.5rem + 3.2vw, 4.5rem)", "lineHeight": "1", "letterSpacing": "-0.03em", "fontWeight": "500" } },
    "display-m": { "$type": "typography", "$value": { "fontSize": "clamp(2.75rem, 1.6rem + 5vw, 6.5rem)", "lineHeight": "0.97", "letterSpacing": "-0.035em", "fontWeight": "500" } },
    "display-l": { "$type": "typography", "$value": { "fontSize": "clamp(3.5rem, 1.4rem + 9.2vw, 12rem)", "lineHeight": "0.92", "letterSpacing": "-0.045em", "fontWeight": "500" } }
  },

  "space": {
    "$type": "dimension",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "3rem" },
    "8": { "$value": "4rem" },
    "9": { "$value": "6rem" },
    "section": { "$value": "clamp(5rem, 3rem + 9vw, 12rem)", "$description": "Between sections" }
  },

  "layout": {
    "$type": "dimension",
    "margin": { "$value": "clamp(1rem, 0.6rem + 1.6vw, 2.25rem)", "$description": "Page side margin" },
    "gutter": { "$value": "clamp(0.5rem, 0.3rem + 0.9vw, 1.5rem)", "$description": "Space between columns" },
    "header": { "$value": "4rem", "$description": "Header height" },
    "columns-wide": { "$type": "number", "$value": 12, "$description": "Above 900px" },
    "columns-mid": { "$type": "number", "$value": 6, "$description": "560px to 900px" },
    "columns-narrow": { "$type": "number", "$value": 4, "$description": "Below 560px" }
  },

  "button": {
    "$type": "dimension",
    "height-sm": { "$value": "2.25rem", "$description": "Header, small controls" },
    "height-md": { "$value": "2.75rem", "$description": "Default" },
    "height-lg": { "$value": "3.5rem", "$description": "Main call to action" },
    "padding-sm": { "$value": "0.9rem" },
    "padding-md": { "$value": "1.25rem" },
    "padding-lg": { "$value": "1.75rem" }
  },

  "radius": {
    "$type": "dimension",
    "none": { "$value": "0", "$description": "Images and layout blocks" },
    "pill": { "$value": "62rem", "$description": "Buttons and toggles" }
  },

  "duration": {
    "$type": "duration",
    "instant": { "$value": "120ms", "$description": "Colour on hover" },
    "fast": { "$value": "280ms", "$description": "Small state changes" },
    "base": { "$value": "560ms", "$description": "Elements moving" },
    "slow": { "$value": "1000ms", "$description": "Text and image reveals" },
    "page": { "$value": "800ms", "$description": "Page transition" },
    "surface": { "$value": "800ms", "$description": "Page fading between grey and black" }
  },

  "ease": {
    "$type": "cubicBezier",
    "out": { "$value": [0.16, 1, 0.3, 1], "$description": "Default. Things arriving." },
    "in-out": { "$value": [0.76, 0, 0.24, 1], "$description": "Things crossing the screen." },
    "standard": { "$value": [0.3, 0, 0.1, 1], "$description": "Small UI states." }
  },

  "stagger": {
    "$type": "duration",
    "line": { "$value": "70ms", "$description": "Between lines of text" },
    "column": { "$value": "32ms", "$description": "Between grid columns" }
  },

  "z": {
    "$type": "number",
    "grid": { "$value": 0 },
    "content": { "$value": 1 },
    "header": { "$value": 50 },
    "grid-visible": { "$value": 70 },
    "loader": { "$value": 100 }
  }
}
