{
  "$description": "Single source of truth for the site. Format follows the W3C Design Tokens spec, so it can be imported in Figma (Tokens Studio or similar). Edit a value, then run: npm run tokens",

  "color": {
    "gray": {
      "$type": "color",
      "$description": "One neutral ramp with no tint, from white down to the page black.",
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f5f5f5" },
      "100": { "$value": "#ebebeb" },
      "200": { "$value": "#d6d6d6" },
      "300": { "$value": "#bdbdbd" },
      "400": { "$value": "#a1a1a1" },
      "500": { "$value": "#7a7a7a" },
      "600": { "$value": "#525252" },
      "700": { "$value": "#2e2e2e" },
      "800": { "$value": "#1f1f1f" },
      "900": { "$value": "#141414" },
      "1000": { "$value": "#0a0a0a" }
    },
    "accent": {
      "hue": { "$type": "number", "$value": 268, "$description": "Change this one number to recolour the whole site. Try it live on /system." },
      "base": { "$type": "color", "$value": "oklch(0.47 0.29 var(--color-accent-hue))", "$description": "The one accent blue, the same on grey and on black." }
    }
  },

  "theme": {
    "$description": "Semantic colours. Components only use these, never the raw grays. The site uses the dark set on every page. The light set is kept as a reference.",
    "light": {
      "$type": "color",
      "bg": { "$value": "{color.gray.50}", "$description": "Page background" },
      "bg-raised": { "$value": "{color.gray.0}", "$description": "Slightly lifted surface" },
      "fg": { "$value": "{color.gray.1000}", "$description": "Main text" },
      "fg-muted": { "$value": "{color.gray.600}", "$description": "Secondary text, passes AA on bg" },
      "fill": { "$value": "{color.gray.1000}", "$description": "Button fill" },
      "on-fill": { "$value": "{color.gray.50}", "$description": "Text on fill" },
      "line": { "$value": "{color.gray.200}", "$description": "Dividers" },
      "grid-line": { "$value": "transparent", "$description": "Resting grid: hidden, the columns only show under the pointer" },
      "grid-glow": { "$value": "color-mix(in srgb, var(--color-gray-1000) 16%, transparent)", "$description": "Grid under the pointer" },
      "accent": { "$value": "{color.accent.base}", "$description": "Focus, selection and live states" },
      "accent-pressed": { "$value": "color-mix(in oklab, var(--color-accent-base) 78%, var(--color-gray-1000))", "$description": "Button while pressed" },
      "focus": { "$value": "{color.accent.base}", "$description": "Keyboard focus ring" },
      "on-accent": { "$value": "{color.gray.0}", "$description": "Text on accent" }
    },
    "dark": {
      "$type": "color",
      "bg": { "$value": "{color.gray.1000}" },
      "bg-raised": { "$value": "{color.gray.900}" },
      "fg": { "$value": "{color.gray.100}" },
      "fg-muted": { "$value": "{color.gray.400}" },
      "fill": { "$value": "{color.gray.100}" },
      "on-fill": { "$value": "{color.gray.1000}" },
      "line": { "$value": "{color.gray.700}" },
      "grid-line": { "$value": "transparent" },
      "grid-glow": { "$value": "color-mix(in srgb, var(--color-gray-0) 20%, transparent)" },
      "accent": { "$value": "{color.accent.base}" },
      "accent-pressed": { "$value": "color-mix(in oklab, var(--color-accent-base) 78%, var(--color-gray-1000))" },
      "focus": { "$value": "{color.gray.100}" },
      "on-accent": { "$value": "{color.gray.0}" }
    }
  },

  "font": {
    "$type": "fontFamily",
    "sans": { "$value": "'Host Grotesk Variable', ui-sans-serif, system-ui, sans-serif" }
  },

  "type": {
    "$description": "Each role gives four variables, for example --type-body-size. Display sizes are fluid: they follow the viewport between the two values in the clamp.",
    "micro": { "$type": "typography", "$value": { "fontSize": "0.8125rem", "lineHeight": "1.3", "letterSpacing": "0", "fontWeight": "400" } },
    "small": { "$type": "typography", "$value": { "fontSize": "0.9375rem", "lineHeight": "1.4", "letterSpacing": "0", "fontWeight": "400" } },
    "body": { "$type": "typography", "$value": { "fontSize": "clamp(1rem, 0.96rem + 0.18vw, 1.125rem)", "lineHeight": "1.5", "letterSpacing": "0", "fontWeight": "400" } },
    "lead": { "$type": "typography", "$value": { "fontSize": "clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem)", "lineHeight": "1.3", "letterSpacing": "-0.01em", "fontWeight": "400" } },
    "title": { "$type": "typography", "$value": { "fontSize": "clamp(1.375rem, 1.2rem + 0.75vw, 1.875rem)", "lineHeight": "1.15", "letterSpacing": "-0.015em", "fontWeight": "500" } },
    "display-s": { "$type": "typography", "$value": { "fontSize": "clamp(1.75rem, 1.35rem + 1.6vw, 2.75rem)", "lineHeight": "1.1", "letterSpacing": "-0.022em", "fontWeight": "500" } },
    "display-m": { "$type": "typography", "$value": { "fontSize": "clamp(2.25rem, 1.55rem + 2.9vw, 4.25rem)", "lineHeight": "1.04", "letterSpacing": "-0.03em", "fontWeight": "500" } },
    "display-l": { "$type": "typography", "$value": { "fontSize": "clamp(2.75rem, 1.6rem + 4.6vw, 6rem)", "lineHeight": "0.98", "letterSpacing": "-0.035em", "fontWeight": "500" } }
  },

  "space": {
    "$type": "dimension",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "3rem" },
    "8": { "$value": "4rem" },
    "9": { "$value": "6rem" },
    "section": { "$value": "clamp(4.5rem, 3rem + 6vw, 9rem)", "$description": "Between sections" }
  },

  "layout": {
    "$type": "dimension",
    "margin": { "$value": "clamp(1rem, 0.6rem + 1.6vw, 2.25rem)", "$description": "Page side margin" },
    "max": { "$value": "80rem", "$description": "Widest the content gets. Past it, the side margins grow" },
    "gutter": { "$value": "clamp(0.5rem, 0.3rem + 0.9vw, 1.5rem)", "$description": "Space between columns" },
    "header": { "$value": "4rem", "$description": "Header height" },
    "columns-wide": { "$type": "number", "$value": 12, "$description": "Above 900px" },
    "columns-mid": { "$type": "number", "$value": 6, "$description": "560px to 900px" },
    "columns-narrow": { "$type": "number", "$value": 4, "$description": "Below 560px" }
  },

  "button": {
    "$type": "dimension",
    "height-sm": { "$value": "2.25rem", "$description": "Header, small controls" },
    "height-md": { "$value": "2.75rem", "$description": "Default" },
    "height-lg": { "$value": "3.5rem", "$description": "Main call to action" },
    "padding-sm": { "$value": "1rem" },
    "padding-md": { "$value": "1.25rem" },
    "padding-lg": { "$value": "1.75rem" }
  },

  "radius": {
    "$type": "dimension",
    "none": { "$value": "0", "$description": "Layout blocks" },
    "media": { "$value": "0.5rem", "$description": "Screens and videos" },
    "pill": { "$value": "62rem", "$description": "Buttons and toggles" }
  },

  "duration": {
    "$type": "duration",
    "instant": { "$value": "120ms", "$description": "Colour on hover" },
    "fast": { "$value": "280ms", "$description": "Small state changes" },
    "base": { "$value": "560ms", "$description": "Elements moving" },
    "slow": { "$value": "1000ms", "$description": "Text and image reveals" },
    "page": { "$value": "800ms", "$description": "Page transition" },
    "surface": { "$value": "800ms", "$description": "Surface colours changing" }
  },

  "ease": {
    "$type": "cubicBezier",
    "out": { "$value": [0.16, 1, 0.3, 1], "$description": "Default. Things arriving." },
    "in-out": { "$value": [0.76, 0, 0.24, 1], "$description": "Things crossing the screen." },
    "standard": { "$value": [0.3, 0, 0.1, 1], "$description": "Small UI states." }
  },

  "stagger": {
    "$type": "duration",
    "line": { "$value": "70ms", "$description": "Between lines of text" },
    "column": { "$value": "32ms", "$description": "Between grid columns" }
  },

  "z": {
    "$type": "number",
    "grid": { "$value": 0 },
    "content": { "$value": 1 },
    "header": { "$value": 50 },
    "grid-visible": { "$value": 70 },
    "loader": { "$value": 100 }
  }
}
