---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Shot from '../../components/Shot.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);

const facts = [
  { label: 'Role', value: p.role },
  { label: 'Period', value: p.period },
  { label: 'Domain', value: p.domain },
  { label: 'Scope', value: p.tags.join(', ') },
];
---

<Layout title={p.title} description={p.summary} image={p.cover.src}>
  <article>
    <header class="intro grid">
      <h1 class="name t-display-l" data-split>{p.title}</h1>
      <p class="summary t-display-s" data-split>{p.summary}</p>
    </header>

    <dl class="facts grid t-small">
      {
        facts.map((f, i) => (
          <div class="fact" data-fade style={`--fade-delay:${i * 60}ms`}>
            <dt class="muted">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="cover grid">
      <div class="full">
        <Shot src={p.cover} alt={p.coverAlt} slats={12} eager cover morph={`cover-${project.id}`} />
      </div>
    </div>

    <section class="context section grid">
      <div class="lead t-lead" data-fade><Content /></div>
      <div class="owned">
        <h2 class="t-small muted">What I owned</h2>
        <ul class="t-body">
          {p.owned.map((item) => <li data-fade>{item}</li>)}
        </ul>
      </div>
      <div class="team">
        <h2 class="t-small muted">Who I worked with</h2>
        <p class="t-body" data-fade>{p.team}</p>
      </div>
      {
        p.results.length > 0 && (
          <div class="results">
            <h2 class="t-small muted">What came out of it</h2>
            <dl class="result-list">
              {p.results.map((r) => (
                <div class="result" data-fade>
                  <dd class="t-display-s tnum">{r.value}</dd>
                  <dt class="t-small muted">{r.label}</dt>
                </div>
              ))}
            </dl>
          </div>
        )
      }
    </section>

    {
      p.chapters.map((chapter) => (
        <section class="chapter grid">
          <div class="chapter-text">
            <h2 class="t-title" data-split>{chapter.title}</h2>
            {chapter.text.map((para) => <p data-fade>{para}</p>)}
          </div>
          <div class="chapter-media">
            {chapter.video && (
              <div class="video-frame">
                <video data-autoplay muted loop playsinline preload="none" src={chapter.video} aria-label="Screen recording of the campaign creation flow" />
              </div>
            )}
            {chapter.media.map((m) => (
              <Shot src={m.src} alt={m.alt} sizes="(max-width: 900px) 100vw, 66vw" slats={8} />
            ))}
          </div>
        </section>
      ))
    }

    <a class="next grid brand-trigger" href={`/projects/${next.id}`} style={`--brand-on-grey:${next.data.brand.onGrey};--brand-on-black:${next.data.brand.onBlack}`}>
      <span class="next-label t-small muted">Next project</span>
      <span class="next-name brand-name t-display-m">{next.data.title}</span>
      <span class="next-summary t-small muted">{next.data.summary}</span>
      <span class="next-shot" data-morph={`cover-${next.id}`}>
        <Image src={next.data.cover} alt="" widths={[640, 960, 1440]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" quality={80} loading="lazy" />
      </span>
    </a>
  </article>
</Layout>

<style>
  .intro { padding-top: calc(var(--layout-header) + var(--space-5)); row-gap: var(--space-5); }
  .name { grid-column: 1 / -1; }
  .summary { grid-column: 1 / span 10; max-width: none; }

  .facts { padding-block: var(--space-7) var(--space-5); row-gap: var(--space-4); }
  .fact { grid-column: span 3; border-top: 1px solid var(--line); padding-top: var(--space-2); }
  .fact dt { margin-bottom: var(--space-1); }

  .context { row-gap: var(--space-7); }
  .lead { grid-column: 1 / span 8; }
  .lead :global(p) { max-width: none; }
  .owned { grid-column: 1 / span 4; }
  .team { grid-column: 5 / span 4; }
  .results { grid-column: 9 / -1; }
  .owned h2, .team h2, .results h2 { padding-bottom: var(--space-3); border-bottom: 1px solid var(--line); margin-bottom: var(--space-3); }
  .owned li + li { margin-top: var(--space-1); }
  .result + .result { margin-top: var(--space-5); }
  .result dt { margin-top: var(--space-1); }

  .chapter { row-gap: var(--space-5); padding-bottom: var(--space-section); }
  .chapter-text {
    grid-column: 1 / span 4;
    position: sticky;
    top: var(--space-7);
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-right: var(--space-5);
  }
  .chapter-media { grid-column: 5 / -1; display: flex; flex-direction: column; gap: var(--layout-gutter); }
  /* The recording is 2592 x 1440 with a dark 2px line baked into its edges. The frame shows it minus 3px per side. */
  .video-frame { position: relative; aspect-ratio: 2586 / 1434; background: var(--bg-raised); overflow: clip; }
  .video-frame video {
    position: absolute;
    top: calc(-100% * 3 / 1434);
    left: calc(-100% * 3 / 2586);
    width: calc(100% * 2592 / 2586);
    height: calc(100% * 1440 / 1434);
    max-width: none;
    object-fit: fill;
  }

  .next {
    row-gap: var(--space-3);
    padding-block: var(--space-6);
    border-top: 1px solid var(--line);
    margin-inline: 0;
    align-items: start;
  }
  .next-label { grid-column: 1 / -1; }
  .next-name { grid-column: 1 / span 6; }
  .next-summary { grid-column: 1 / span 4; }
  .next-shot { grid-column: 7 / -1; grid-row: 2 / span 2; display: block; aspect-ratio: 16 / 10; overflow: clip; }
  .next-shot :global(img) { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 900px) {
    .summary, .lead, .owned, .team, .results, .chapter-text, .chapter-media, .next-name, .next-summary, .next-shot { grid-column: 1 / -1; grid-row: auto; }
    .chapter-text { position: static; padding-right: 0; }
    .fact { grid-column: span 3; }
  }
  @media (max-width: 560px) {
    .fact { grid-column: span 2; }
  }
</style>
