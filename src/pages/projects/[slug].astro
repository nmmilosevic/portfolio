---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Shot from '../../components/Shot.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);

const facts = [
  { label: 'Role', value: p.role },
  { label: 'Period', value: p.period },
  { label: 'Domain', value: p.domain },
  { label: 'Scope', value: p.tags.join(', ') },
];
---

<Layout title={p.title} description={p.summary} image={p.cover.src}>
  <article>
    <header class="intro grid">
      <h1 class="name t-display-l" data-split>{p.title}</h1>
      <p class="summary t-display-s" data-split>{p.summary}</p>
    </header>

    <div class="overview grid">
      <dl class="facts t-small">
        {
          facts.map((f, i) => (
            <div class="fact" data-fade style={`--fade-delay:${i * 60}ms`}>
              <dt class="muted">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="cover">
        <Shot src={p.cover} alt={p.coverAlt} sizes="(max-width: 900px) 100vw, 66vw" eager cover morph={`cover-${project.id}`} />
      </div>
    </div>

    <section class="context section grid">
      <div class="lead t-lead" data-fade><Content /></div>
      <div class="owned">
        <h2 class="t-small muted">What I owned</h2>
        <ul class="t-body">
          {p.owned.map((item) => <li data-fade>{item}</li>)}
        </ul>
      </div>
      <div class="team">
        <h2 class="t-small muted">Who I worked with</h2>
        <p class="t-body" data-fade>{p.team}</p>
      </div>
      {
        p.results.length > 0 && (
          <div class="results">
            <h2 class="t-small muted">What came out of it</h2>
            <dl class="result-list">
              {p.results.map((r) => (
                <div class="result" data-fade>
                  <dd class="t-display-s tnum">{r.value}</dd>
                  <dt class="t-small muted">{r.label}</dt>
                </div>
              ))}
            </dl>
          </div>
        )
      }
    </section>

    {
      p.chapters.map((chapter) => (
        <section class="chapter grid">
          <div class="chapter-text">
            <h2 class="t-title" data-split>{chapter.title}</h2>
            {chapter.text.map((para) => <p data-fade>{para}</p>)}
          </div>
          <div class="chapter-media">
            {chapter.video && (
              <div class="video-frame">
                <video data-autoplay muted loop playsinline preload="none" src={chapter.video} aria-label="Screen recording of the campaign creation flow" />
              </div>
            )}
            {chapter.media.map((m) => (
              <Shot src={m.src} alt={m.alt} sizes="(max-width: 900px) 100vw, 66vw" />
            ))}
          </div>
        </section>
      ))
    }
  </article>
</Layout>

<style>
  .intro { padding-top: calc(var(--layout-header) + var(--space-8)); row-gap: var(--space-5); }
  .name { grid-column: 1 / -1; }
  .summary { grid-column: 1 / span 8; max-width: none; }

  /* Facts on the left, screens on the right: the same two columns as the chapters below. */
  .overview { padding-top: var(--space-8); row-gap: var(--space-6); align-items: start; }
  .facts { grid-column: 1 / span 3; display: flex; flex-direction: column; gap: var(--space-4); }
  .fact { border-top: 1px solid var(--line); padding-top: var(--space-2); }
  .fact dt { margin-bottom: var(--space-1); }
  .cover { grid-column: 5 / -1; }

  .context { row-gap: var(--space-7); }
  .lead { grid-column: 1 / span 8; }
  .lead :global(p) { max-width: none; }
  .owned { grid-column: 1 / span 4; }
  .team { grid-column: 5 / span 4; }
  .results { grid-column: 9 / -1; }
  .owned h2, .team h2, .results h2 { padding-bottom: var(--space-3); border-bottom: 1px solid var(--line); margin-bottom: var(--space-3); }
  .owned li + li { margin-top: var(--space-1); }
  .result + .result { margin-top: var(--space-5); }
  .result dt { margin-top: var(--space-1); }

  .chapter { row-gap: var(--space-5); padding-bottom: var(--space-section); }
  /* The footer brings its own space above. */
  .chapter:last-of-type { padding-bottom: 0; }
  .chapter-text {
    grid-column: 1 / span 4;
    position: sticky;
    top: var(--space-7);
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-right: var(--space-5);
  }
  .chapter-media { grid-column: 5 / -1; display: flex; flex-direction: column; gap: var(--space-5); }
  /* The recording is 2592 x 1440 with a dark 2px line baked into its edges. The frame shows it minus 3px per side. */
  .video-frame { position: relative; aspect-ratio: 2586 / 1434; background: var(--bg-raised); overflow: clip; border-radius: var(--radius-media); }
  .video-frame video {
    position: absolute;
    top: calc(-100% * 3 / 1434);
    left: calc(-100% * 3 / 2586);
    width: calc(100% * 2592 / 2586);
    height: calc(100% * 1440 / 1434);
    max-width: none;
    object-fit: fill;
  }

  @media (max-width: 900px) {
    .summary, .facts, .cover, .lead, .owned, .team, .results, .chapter-text, .chapter-media { grid-column: 1 / -1; }
    .chapter-text { position: static; padding-right: 0; }
    .facts { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4) var(--layout-gutter); }
  }
</style>
